{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exmioaj",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true,
  },
  "main": "worker.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "compatibility_flags": ["nodejs_compat"],
}
